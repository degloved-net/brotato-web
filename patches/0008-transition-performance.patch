diff --git a/singletons/menu_data.gd b/singletons/menu_data.gd
index 0c17e27e..5fa3e132 100644
--- a/singletons/menu_data.gd
+++ b/singletons/menu_data.gd
@@ -10,3 +10,41 @@ var shop_scene: String = "res://ui/menus/shop/shop.tscn"
 var character_selection_scene: String = "res://ui/menus/run/character_selection.tscn"
 var weapon_selection_scene: String = "res://ui/menus/run/weapon_selection.tscn"
 var difficulty_selection_scene: String = "res://ui/menus/run/difficulty_selection/difficulty_selection.tscn"
+
+
+# Keep frequently revisited scenes alive so Godot can reuse their resources.
+# Polling across frames avoids moving a synchronous load into the title screen.
+var _web_scene_cache: = {}
+var _web_scene_paths: = []
+var _web_scene_loader: ResourceInteractiveLoader
+var _web_scene_path: String
+
+
+func _ready() -> void:
+	if OS.get_name() != "HTML5":
+		set_process(false)
+		return
+	_web_scene_paths = [character_selection_scene, weapon_selection_scene,
+		difficulty_selection_scene, game_scene, shop_scene,
+		"res://ui/menus/shop/coop_shop.tscn", title_screen_scene]
+
+
+func _process(_delta: float) -> void:
+	var deadline = OS.get_ticks_usec() + 4000
+	while OS.get_ticks_usec() < deadline:
+		if _web_scene_loader == null:
+			if _web_scene_paths.empty():
+				set_process(false)
+				return
+			_web_scene_path = _web_scene_paths.pop_front()
+			_web_scene_loader = ResourceLoader.load_interactive(_web_scene_path)
+			if _web_scene_loader == null:
+				push_warning("Could not warm scene: " + _web_scene_path)
+				continue
+		var error = _web_scene_loader.poll()
+		if error == ERR_FILE_EOF:
+			_web_scene_cache[_web_scene_path] = _web_scene_loader.get_resource()
+			_web_scene_loader = null
+		elif error != OK:
+			push_warning("Could not warm scene: " + _web_scene_path + " (" + str(error) + ")")
+			_web_scene_loader = null
