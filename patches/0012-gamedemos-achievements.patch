+const GDP_AWARDS_JS: = """
+(function () {
+	if (window.gdpAwards) { return true; }
+	var BASE = 'https://gamedemos.omgwow.tech/api/v1/awards';
+	var TICKET_RE = /^gdp_play_[A-Za-z0-9_-]{20,128}$/;
+	var KEY_RE = /^chal_[a-z0-9_-]{1,59}$/;
+	var ticket = new URLSearchParams(window.location.search).get('gdp_ticket') || '';
+	var usable = TICKET_RE.test(ticket);
+	var settled = {};
+	var queue = Promise.resolve();
+
+	if (usable) {
+		queue = queue.then(function () {
+			return fetch(BASE + '/session', {
+				method: 'POST',
+				headers: { 'Authorization': 'Bearer ' + ticket }
+			}).then(function (res) {
+				if (res.status === 401 || res.status === 403) {
+					usable = false;
+				}
+			}).catch(function () {});
+		});
+	}
+
+	function send(key) {
+		return fetch(BASE, {
+			method: 'POST',
+			headers: { 'Authorization': 'Bearer ' + ticket, 'Content-Type': 'application/json' },
+			body: JSON.stringify({ key: key })
+		}).then(function (res) {
+			if (res.status === 401) {
+				usable = false;
+			} else if (res.status !== 500 && res.status !== 502 && res.status !== 503 && res.status !== 504) {
+				settled[key] = true;
+			}
+		}).catch(function () {});
+	}
+
+	window.gdpAwards = {
+		report: function (key) {
+			if (!usable || settled[key] || !KEY_RE.test(key)) { return; }
+			queue = queue.then(function () {
+				return usable && !settled[key] ? send(key) : null;
+			});
+		}
+	};
+	return true;
+})()
+"""
+
+var _gdp_awards_ready: = false
+
+
+func _ensure_gdp_awards() -> bool:
+	if not _gdp_awards_ready:
+		_gdp_awards_ready = JavaScript.eval(GDP_AWARDS_JS, true) == true
+	return _gdp_awards_ready
+
+
