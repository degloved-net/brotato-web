diff --git a/web_shell.html b/web_shell.html
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/web_shell.html
@@ -0,0 +1,102 @@
+<!doctype html>
+<html lang="en">
+  <head>
+    <meta charset="utf-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+    <title>$GODOT_PROJECT_NAME</title>
+    <style>
+      *,
+      *::before,
+      *::after {
+        box-sizing: border-box;
+        margin: 0;
+        padding: 0;
+      }
+      html,
+      body {
+        width: 100%;
+        height: 100%;
+        overflow: hidden;
+        background: #000;
+      }
+      #loading {
+        position: absolute;
+        inset: 0;
+        display: flex;
+        align-items: center;
+        justify-content: center;
+        color: #fff;
+        font: 1.5rem/1 sans-serif;
+        z-index: 1;
+        flex-direction: column;
+        gap: 1rem;
+      }
+      #loading.hidden {
+        display: none;
+      }
+      canvas {
+        width: 100%;
+        height: 100%;
+        display: block;
+      }
+    </style>
+$GODOT_HEAD_INCLUDE
+  </head>
+  <body>
+    <div id="loading">loading game content...</div>
+    <canvas id="canvas" oncontextmenu="event.preventDefault()">
+      HTML5 canvas appears to be unsupported in the current browser.<br />
+      Please try updating or use a different browser.
+    </canvas>
+    <script type="text/javascript" src="$GODOT_URL"></script>
+    <script>
+      const GODOT_CONFIG = $GODOT_CONFIG;
+      const engine = new Engine(GODOT_CONFIG);
+      const loading = document.getElementById("loading");
+      const pck = new URL(GODOT_CONFIG.executable + ".pck", location.href).href;
+      const originalFetch = window.fetch.bind(window);
+      const cacheName = "brotato-game-__BROTATO_BUILD_ID__";
+      let gameContent = "loading game content";
+
+      function showFailure(error) {
+        loading.textContent = error.message || error;
+      }
+
+      function prepareGameCache() {
+        if (!window.caches) return Promise.resolve();
+        return caches.open(cacheName).then((cache) => {
+          return cache.match(pck).then((cached) => {
+            if (cached) gameContent = "loading cached game content";
+            window.fetch = (resource, options) => {
+              const url = new URL(resource instanceof Request ? resource.url : resource, location.href).href;
+              if (url !== pck) return originalFetch(resource, options);
+              return cache.match(pck).then((response) => {
+                if (response) return response;
+                return originalFetch(resource, options).then((networkResponse) => {
+                  if (networkResponse.ok) cache.put(pck, networkResponse.clone()).catch(() => {});
+                  return networkResponse;
+                });
+              });
+            };
+          });
+        }).catch(() => {});
+      }
+
+      if (!Engine.isWebGLAvailable()) {
+        showFailure("webgl not available");
+      } else {
+        if (navigator.storage && navigator.storage.persist) navigator.storage.persist().catch(() => {});
+        prepareGameCache().then(() => {
+          loading.textContent = gameContent + "...";
+          return engine.startGame({
+            onProgress: (current) => {
+              loading.textContent = gameContent + "... " + Math.floor(current / 1048576) + " mb";
+            },
+          });
+        }).then(() => {
+          loading.classList.add("hidden");
+        }, showFailure);
+      }
+    </script>
+  </body>
+</html>
